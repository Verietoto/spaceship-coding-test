# Copy to backend/.env (git-ignored) and fill in.
#   API:   uv run --env-file .env alembic upgrade head && uv run --env-file .env python -m app.modules.analytics.seed
#          uv run --env-file .env uvicorn app.main:app --port 8010
#   Tests: uv run --env-file .env pytest
DATABASE_URL=postgresql+psycopg://spaceship:spaceship@localhost:5432/spaceship
# Login created by migration 0003 with ANALYTICS_RO_PASSWORD; runs every SQL query written by the LLM (SELECT on orders only)
ANALYTICS_RO_PASSWORD=change-me
DATABASE_URL_READONLY=postgresql+psycopg://analytics_ro:change-me@localhost:5432/spaceship
# Separate database for tests (migrated + seeded automatically; app tables are truncated between tests)
TEST_DATABASE_URL=postgresql+psycopg://spaceship:spaceship@localhost:5432/spaceship_test
TEST_DATABASE_URL_READONLY=postgresql+psycopg://analytics_ro:change-me@localhost:5432/spaceship_test
# The Backoffice (admin > AI) can override the provider, key and models below without a restart; these stay as the fallback.
OPENAI_API_KEY=
# Optional: any OpenAI-compatible API, e.g. OpenRouter (then OPENAI_MODEL is its id, e.g. openai/gpt-4.1-mini)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-6-luna
# Optional: a different (e.g. cheaper) model for the subagents; empty = same as OPENAI_MODEL
OPENAI_MODEL_SUBAGENT=
# Jev (TypeSafe) decides which tools/subagents each Copilot request loads. Empty key = no routing, everything is loaded.
TYPESAFE_API_KEY=
JEV_THRESHOLD=0.6
JEV_TIMEOUT_MS=1000
# Guardrails (Jev): confidence to block, and a lower one for "off topic"
GUARD_THRESHOLD=0.7
GUARD_OFFTOPIC_THRESHOLD=0.6
# Accounts created by: python -m app.modules.auth.seed (an account with an empty email or password is skipped)
ADMIN_EMAIL=
ADMIN_PASSWORD=
VISITOR_EMAIL=
VISITOR_PASSWORD=
# Required, no default: the app refuses to start without it. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Optional Fernet key that encrypts the AI key saved in the Backoffice (without it the key can only come from OPENAI_API_KEY).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_KEY=
# How long a login lasts (hours)
SESSION_HOURS=8
# 1 behind HTTPS (production)
SECURE_COOKIES=0

# Rate limits (defaults shown)
# LOGIN_IP_PER_MINUTE=20
# LOGIN_MAX_FAILURES=5
# AI_PER_MINUTE=10
# AI_PER_HOUR=100
# AI_CONCURRENT=2
# DASH_SAVES_PER_HOUR=20
# DASH_OPENS_PER_MINUTE=60
# ENABLE_DOCS=1   # serve /docs and /openapi.json (off by default; its page loads scripts the CSP blocks, so use it on a dev copy)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # extra browser origins allowed to write (default: the Vite dev server)
